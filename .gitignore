node_modules/
dist/
dist-static/
.env
.env.local
*.log

# Downloaded protoc-gen-grpc-web binary -- see proto/scripts/fetch-protoc-gen-grpc-web.mjs
.tools/

# Generated browser proto/grpc-web JS -- regenerated by `npm run proto:gen-web`
packages/proto-gen-web/widgetgrid/
packages/proto-gen-web/lhoraire/

# Vendored Vue copy -- regenerated by web-app's predev/prebuild copy script
packages/web-app/public/vendor/*
!packages/web-app/public/vendor/.gitkeep

# Staged copy of the sibling ~/GIT/solitaire repo's build output, made by
# infra/eks/deploy.sh so it's inside the Docker build context for
# packages/static-server/Dockerfile (Docker can't COPY from outside its
# build context, i.e. never from ../solitaire directly) -- see
# widgets/solitaire/scripts/vendor-solitaire.mjs.
widgets/solitaire/.vendor-src/

# Same staging trick, for the sibling ~/GIT/bolo-server repo's build output
# -- see widgets/embuscade/scripts/vendor-embuscade.mjs.
widgets/embuscade/.vendor-src/
widgets/lastnaming/.vendor-src/

# Built widget bundles (and their vendored games and assets), copied in from
# each widgets/*/dist by packages/web-app/scripts/copy-widgets.mjs --
# regenerated by `npm run build:widgets`, and rebuilt by the Docker build.
packages/web-app/public/widgets/

# vim <3
.*.sw?
*.sw?
*~

# Images uploaded while running locally (packages/server mediaStore.js).
.media/

# CDK's synthesized output -- regenerated by every `cdk synth`/`cdk deploy`
# (infra/cdk); the stacks themselves are in infra/cdk/lib.
infra/cdk/cdk.out/
