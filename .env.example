# Copy to .env and adjust for your machine.

# packages/db and packages/server
DATABASE_URL=postgres://widgetgrid:widgetgrid@localhost:5432/widgetgrid

# packages/server -- the local grpc-js listener. The Consul Connect sidecar
# (running alongside this process, not shown here) is what actually terminates
# mTLS and is what Envoy/other mesh services talk to -- this app only ever
# binds plaintext on localhost, per the standard Connect pattern.
GRPC_SERVER_HOST=127.0.0.1
GRPC_SERVER_PORT=50051

# packages/server -- local stand-in for the S3 bucket the blog reads from in
# production (see blogSource.js). Defaults to content/blog at the repo root
# if unset.
# BLOG_CONTENT_DIR=/absolute/path/to/content/blog

# packages/server -- public URL prefix each post's own image subdirectory
# (content/blog/<post-file-without-.md>/) is served under. Defaults to
# /blog-assets, served locally by web-app's dev server middleware and
# assemble-static.mjs; production would point this at wherever the S3
# bucket/CDN publicly serves the same prefix from.
# BLOG_ASSETS_BASE_URL=/blog-assets

# packages/server -- how often the local "new post" poll runs (see
# blogChangeNotifier.js). Irrelevant once a real S3-event-driven notifier
# replaces this local one, since that's push, not poll. Defaults to 20s.
# BLOG_POLL_INTERVAL_MS=20000

# packages/server -- the phone number offline-visitor-message alerts go to
# (see smsSender.js). Locally the message is just logged to the server's
# console instead of actually texted.
# OWNER_PHONE_NUMBER=+15555550100

# packages/server -- the addresses that get role 'owner' on sign-in (server
# side of chat, owner presence, moderation), comma-separated. Everyone else
# who signs in is a 'member'. See packages/server/src/siteAccounts.js.
# OWNER_EMAIL=owner@example.com,site@example.com

# packages/server -- usernames that belong to particular addresses,
# comma-separated name=email pairs. The address gets its name
# automatically once it has proved it owns it (the emailed code), and
# nobody else can take it.
# ASSIGNED_USERNAMES=sitename=site@example.com

# packages/server -- Web Push (owner chat notifications, see pushSender.js).
# Generate once: npx web-push generate-vapid-keys. Unset = push disabled.
# Changing them invalidates every existing browser subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:webmaster@pie-laboratories.com

# packages/server -- blog subscription emails (see emailSender.js,
# subscriptionService.js, postMailer.js). EMAIL_PROVIDER unset/'console'
# logs each email (confirmation links included) instead of sending; the
# EKS manifest sets 'ses'. SITE_ORIGIN is what emailed and RSS links are
# built on. Defaults shown.
# EMAIL_PROVIDER=console
# SITE_ORIGIN=http://localhost:5173
# EMAIL_FROM=Pie Laboratories <news@pie-laboratories.com>
# EMAIL_REPLY_TO=webmaster@pie-laboratories.com

# packages/server -- uploaded images (mediaStore.js, moderation.js). Locally
# they're kept in MEDIA_DIR and every image passes; the EKS manifest sets
# MEDIA_S3_BUCKET and IMAGE_MODERATION=rekognition. BLOG_TIME_ZONE dates
# posts published on the site (/site/write). Defaults shown.
# MEDIA_DIR=.media
# IMAGE_MODERATION=none
# BLOG_TIME_ZONE=America/Denver

# packages/server -- on-site registration (registrar.js). Unset/'console'
# keeps sign-ups in memory and prints the verification code to the log
# (nothing reaches Cognito); the EKS manifest sets 'cognito', with the
# registration client's id/secret put in the secret by infra/eks/deploy.sh.
# REGISTRAR=console
# COGNITO_REGISTRATION_CLIENT_ID=
# COGNITO_REGISTRATION_CLIENT_SECRET=

# Cloudflare Turnstile, the captcha on the subscribe and registration forms. The secret key is
# widgetgrid-server's (unset = checks skipped, fine locally); the site key
# is public and baked into the widget bundles at build time -- read from
# here by infra/eks/deploy.sh. Unset locally, the widget uses Cloudflare's
# always-pass test key.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# The site's Bluesky account, for "Post to Bluesky" on /site/write: an app
# password (Bluesky: Settings -> Privacy and security -> App passwords),
# not the account's own password. Unset = what would be posted is only
# logged. Read by infra/eks/deploy.sh into widgetgrid-server-secret.
# BLUESKY_HANDLE=pielabs.bsky.social
# BLUESKY_APP_PASSWORD=

# packages/static-server
STATIC_SERVER_PORT=8081
# widgetgrid-server's gRPC address, for /rss.xml and /email/unsubscribe
# (static-server's edgeRoutes.js; also mounted by web-app's Vite dev
# server). Locally against local-k8s/, port-forward it first:
#   kubectl port-forward -n widgetgrid deploy/widgetgrid-server 50051:50051
# WIDGETGRID_GRPC_ADDR=127.0.0.1:50051
STATIC_DIR=../../dist-static
