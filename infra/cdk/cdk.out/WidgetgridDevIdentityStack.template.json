  "PreTokenAdminsEB0B982D": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\n        const admins = (process.env.ADMIN_EMAILS || '').toLowerCase().split(',').filter(Boolean);\n        exports.handler = async (event) => {\n          const email = (event.request.userAttributes.email || '').toLowerCase();\n          if (admins.includes(email)) {\n            event.response.claimsOverrideDetails = { groupOverrideDetails: { groupsToOverride: ['anonyme admins'] } };\n          }\n          return event;\n        };\n      "
    },
    "Environment": {
     "Variables": {
      "ADMIN_EMAILS": "webmaster@pie-laboratories.com"
     }
    },
    "Handler": "index.handler",
    "Role": {
     "Fn::GetAtt": [
      "PreTokenAdminsServiceRole20AA2C99",
      "Arn"
     ]
    },
    "Runtime": "nodejs22.x",
    "Timeout": 5
   },
   "DependsOn": [
    "PreTokenAdminsServiceRole20AA2C99"
   ],
   "Metadata": {
    "aws:cdk:path": "WidgetgridDevIdentityStack/PreTokenAdmins/Resource"
   }
