{
  "name": "widgetgrid",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "widgets/*"
  ],
  "devDependencies": {
    "grpc-tools": "1.13.1"
  },
  "scripts": {
    "db:migrate": "npm run migrate --workspace packages/db",
    "db:seed": "node packages/db/seeds/seed.mjs",
    "proto:fetch-plugin": "node proto/scripts/fetch-protoc-gen-grpc-web.mjs",
    "proto:gen-web": "node proto/scripts/gen-web.mjs",
    "dev:server": "npm run dev --workspace packages/server",
    "dev:web": "npm run dev --workspace packages/web-app",
    "build:web": "npm run build --workspace packages/web-app",
    "build:widgets": "npm run build --workspace widgets/richtext --workspace widgets/table --workspace widgets/splash --workspace widgets/topbar --workspace widgets/rightrail --workspace widgets/blog --workspace widgets/main --workspace widgets/solitaire --workspace widgets/chat --workspace widgets/login",
    "build:all": "npm run build --workspaces --if-present",
    "assemble-static": "node scripts/assemble-static.mjs",
    "serve:static": "npm run start --workspace packages/static-server"
  },
  "allowScripts": {
    "grpc-tools@1.13.1": true,
    "protobufjs@7.6.5": true
  }
}
